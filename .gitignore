# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/public/portfolio
/hostico-deploy
/hostico-deploy-nomedia
/deploy
/deploy_tmp
/_RawPortfolioVideos
/_ProcessedPortfolio
# misc
.DS_Store
*.pem
*.zip
current_changes.diff
# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# media (excluded as requested)
*.mp4
*.webm
*.mov
*.ogg
/public/portfolio/**/*.mp4
/public/portfolio/**/*.webm
