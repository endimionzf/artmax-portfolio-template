{
  "name": "immersive-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "predev": "node scripts/generate-portfolio-json.mjs",
    "prebuild": "node scripts/generate-portfolio-json.mjs && node scripts/generate-sitemap.mjs",
    "build": "next build --webpack",
    "generate:portfolio": "node scripts/generate-portfolio-json.mjs",
    "migrate:media": "node scripts/migrate-to-flat-media.mjs",
    "edit": "node scripts/editor-server.mjs",
    "preview": "npx serve out",
    "lint": "eslint",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "package": "node scripts/package-static.mjs",
    "package:nomedia": "node scripts/package-static.mjs --no-media",
    "export:win": "powershell -ExecutionPolicy Bypass -File export.ps1",
    "thumbnails": "node scripts/generate-thumbnails.mjs",
    "optimize": "node scripts/optimize-videos.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@types/three": "^0.183.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lenis": "^1.3.17",
    "leva": "^0.10.1",
    "maath": "^0.10.8",
    "next": "16.1.6",
    "next-view-transitions": "^0.3.5",
    "postprocessing": "^6.38.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
