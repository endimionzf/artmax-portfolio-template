RewriteEngine On
RewriteBase /

# 1. PHYSICAL FILES & SUBDIRECTORIES
# If the request is for an actual file OR an actual folder, serve it directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Explicit skip for known subdirectories
RewriteRule ^(fetedeimprumut)($|/) - [L]

# 2. CUSTOM 404 HANDLER
ErrorDocument 404 /404.html

# 3. HTTP HEADERS & CACHING
<IfModule mod_headers.c>
  # Video and audio streaming: enable byte-range requests and CORS
  <FilesMatch "\.(mp4|webm|mp3|ogg|wav)$">
    Header set Accept-Ranges bytes
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # Static assets (fonts, images, hashed Next.js bundles): immutable long-term caching
  <FilesMatch "\.(ttf|otf|eot|woff|woff2|ico|png|jpg|jpeg|svg|webp|avif|js|css)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Dynamic metadata & HTML: immediate revalidation
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
